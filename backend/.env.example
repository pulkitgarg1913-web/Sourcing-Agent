# Google Gemini AI API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-1.5-flash
GEMINI_TIMEOUT_MS=15000

# Voice / TTS / STT Configuration (Optional)
GEMINI_TTS_VOICE=Kore
GEMINI_TTS_MODELS=gemini-2.5-flash-preview-tts
GEMINI_STT_MODELS=gemini-2.5-flash

# Railway & Supplier Performance Optimization
BOODMO_TIMEOUT_SECONDS=30
AUTODUKAN_TIMEOUT_SECONDS=30
NAVIGATION_TIMEOUT_SECONDS=15000
NAVIGATION_RETRY_TIMEOUT_SECONDS=10000
WEB_CONCURRENCY=1
